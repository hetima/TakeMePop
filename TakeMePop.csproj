<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NETSDK1206;WPF0001</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="SharpHook" Version="7.1.2" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationIcon>Properties/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AGENTS.md" />
    <None Remove="CLAUDE.md" />
    <None Remove="README.md" />
  </ItemGroup>
    <ItemGroup>
    <Resource Include="Properties/tray-icon.ico" />
  </ItemGroup>
</Project>
