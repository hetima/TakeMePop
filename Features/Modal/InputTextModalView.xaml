<UserControl x:Class="Listhing.Views.InputTextModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400"
             Loaded="OnLoaded">
    <Grid>
        <StackPanel Margin="24" VerticalAlignment="Center">
            <!-- メッセージ -->
            <TextBlock Text="{Binding Message}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            
            <!-- テキスト入力フィールド -->
            <TextBox x:Name="InputTextBox"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnInputKeyDown"
                     FontSize="14"
                     Padding="8,6"
                     Margin="0,0,0,24"/>
            
            <!-- ボタンエリア -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"
                        Padding="16,8"
                        Margin="0,0,6,0"
                        Visibility="{Binding OkOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Button Content="{Binding OkLabel}"
                        Command="{Binding OkCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="100"
                        Padding="16,8"
                        Margin="6,0,0,0"/>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
