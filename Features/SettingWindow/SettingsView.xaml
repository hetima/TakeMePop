<UserControl x:Class="Listhing.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:res="clr-namespace:Listhing"
             xmlns:converters="clr-namespace:Listhing.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ShortcutKeyToStringConverter x:Key="ShortcutKeyToStringConverter"/>
        <Style TargetType="ListViewItem" x:Key="MySettingListViewItemStyle" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="8,4,8,4" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- 設定コンテンツ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- セクション選択ListBox -->
            <ListBox x:Name="SectionListBox"
                     Grid.Column="0"
                     SelectedIndex="0"
                     SelectionMode="Single"
                     SelectionChanged="SectionListBox_SelectionChanged">
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionAppearance}"/>
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionAction}"/>
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionOther}"/>
            </ListBox>

            <!-- セクションコンテンツ（ScrollViewer内） -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- Appearance Section -->
                    <StackPanel x:Name="AppearanceSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Visible">
                        <!-- Theme Selection -->
                        <TextBlock Text="{x:Static res:Strings.ThemeLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedIndex="{Binding SelectedTheme, Converter={StaticResource ThemeToIndexConverter}}"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8">
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeAuto}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeLight}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeDark}"/>
                        </ComboBox>

                        <!-- Language Selection -->
                        <TextBlock Text="{x:Static res:Strings.LanguageLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        <ComboBox SelectedIndex="{Binding SelectedLanguage, Converter={StaticResource LanguageToIndexConverter}}"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8">
                            <ComboBoxItem Content="{x:Static res:Strings.LanguageEn}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.LanguageJa}"/>
                        </ComboBox>
                        <!-- Restart Notice -->
                        <TextBlock Text="{x:Static res:Strings.RestartRequired}"
                                   FontStyle="Italic"
                                   Margin="0,24,0,0"
                                   Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Font Size Selection -->
                        <TextBlock Text="{x:Static res:Strings.FontSizeLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="10"
                                    Maximum="32"
                                    Value="{Binding FontSize}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FontSize, StringFormat={}{0:F0}}"
                                       Width="40"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Action Section -->
                    <StackPanel x:Name="ActionSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Collapsed">
                        <!-- Basic Action Label -->
                        <TextBlock Text="{x:Static res:Strings.BasicActionLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Basic Action ListView -->
                        <ListView BorderThickness="1"
                                  BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                  Background="Transparent"
                                  Padding="4">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="MySettingListViewItemStyle"/>
                            </ListView.ItemContainerStyle>
                            <ListViewItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Strings.DefaultOpenActionLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultOpenKey, Converter={StaticResource ShortcutKeyToStringConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               FontFamily="Consolas"
                                               FontSize="13"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static res:Strings.EditButtonLabel}"
                                            Padding="12,6"
                                            Click="EditDefaultOpenKey_Click"
                                            MinWidth="60"/>
                                </Grid>
                            </ListViewItem>
                            <ListViewItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Strings.RevealActionLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RevealKey, Converter={StaticResource ShortcutKeyToStringConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               FontFamily="Consolas"
                                               FontSize="13"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static res:Strings.EditButtonLabel}"
                                            Padding="12,6"
                                            Click="EditRevealKey_Click"
                                            MinWidth="60"/>
                                </Grid>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                    <!-- Other Section -->
                    <StackPanel x:Name="OtherSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Collapsed">
                        <Button Content="{x:Static res:Strings.OpenSettingsFolder}"
                                HorizontalAlignment="Center"
                                Padding="24,12"
                                Click="OpenSettingsFolder_Click"
                                Margin="0,0,0,16"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
