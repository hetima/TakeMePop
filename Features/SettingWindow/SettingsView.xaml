<UserControl x:Class="Listhing.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:res="clr-namespace:Listhing"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:Listhing.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ShortcutKeyToStringConverter x:Key="ShortcutKeyToStringConverter"/>
        <Style TargetType="ListViewItem" x:Key="MySettingListViewItemStyle" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="8,4,8,4" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- 設定コンテンツ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- セクション選択ListBox -->
            <ListBox x:Name="SectionListBox"
                     Grid.Column="0"
                     SelectedIndex="0"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource MyListBoxItemStyle}"
                     SelectionChanged="SectionListBox_SelectionChanged">
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionGeneral}"/>
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionAction}"/>
                <ListBoxItem Content="{x:Static res:Strings.PwSectionTitle}"/>
                <ListBoxItem Content="{x:Static res:Strings.QtSectionTitle}"/>
                <ListBoxItem Content="{x:Static res:Strings.QhSectionTitle}"/>
                <ListBoxItem Content="{x:Static res:Strings.TgSectionTitle}"/>
                <ListBoxItem Content="{x:Static res:Strings.SettingsSectionOther}"/>
            </ListBox>

            <!-- セクションコンテンツ（ScrollViewer内） -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- General Section -->
                    <StackPanel x:Name="GeneralSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Visible">
                        <!-- Run at Startup -->
                        <CheckBox Content="{x:Static res:Strings.RunAtStartupLabel}"
                                  IsChecked="{Binding RunAtStartup}"
                                  Margin="0,0,0,24"/>

                        <!-- Theme Selection -->
                        <TextBlock Text="{x:Static res:Strings.ThemeLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedIndex="{Binding SelectedTheme, Converter={StaticResource ThemeToIndexConverter}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8">
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeAuto}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeLight}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.ThemeDark}"/>
                        </ComboBox>

                        <!-- Language Selection -->
                        <TextBlock Text="{x:Static res:Strings.LanguageLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        <ComboBox SelectedIndex="{Binding SelectedLanguage, Converter={StaticResource LanguageToIndexConverter}}"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8">
                            <ComboBoxItem Content="{x:Static res:Strings.LanguageEn}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.LanguageJa}"/>
                        </ComboBox>
                        <!-- Restart Notice -->
                        <TextBlock Text="{x:Static res:Strings.RestartRequired}"
                                   FontStyle="Italic"
                                   Margin="0,24,0,0"
                                   Visibility="{Binding IsRestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/>


                        <!-- Popup Font Family -->
                        <TextBlock Text="{x:Static res:Strings.PopupFontFamilyLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        <ComboBox ItemsSource="{Binding FontFamilyItems}"
                                  SelectedValue="{Binding PopupFontFamily}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8"/>

                        <!-- Font Size Selection -->
                        <TextBlock Text="{x:Static res:Strings.FontSizeLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="10"
                                    Maximum="28"
                                    Value="{Binding FontSize}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FontSize, StringFormat={}{0:F0}}"
                                       Width="40"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>

                    <!-- Action Section -->
                    <StackPanel x:Name="ActionSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Collapsed">
                        <!-- Section Description -->
                        <TextBlock Text="{x:Static res:Strings.ShortcutSectionDescription}"
                                   Opacity="0.75"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Basic Action Label -->
                        <TextBlock Text="{x:Static res:Strings.BasicActionLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        
                        <!-- Basic Action ListView -->
                        <ListView BorderThickness="1"
                                  BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                  Background="Transparent"
                                  Padding="4">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="MySettingListViewItemStyle"/>
                            </ListView.ItemContainerStyle>
                            <ListViewItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Strings.DefaultOpenActionLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultOpenKey, Converter={StaticResource ShortcutKeyToStringConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               FontFamily="Consolas"
                                               FontSize="13"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static res:Strings.EditButtonLabel}"
                                            Padding="12,6"
                                            Click="EditDefaultOpenKey_Click"
                                            MinWidth="60"/>
                                </Grid>
                            </ListViewItem>
                            <ListViewItem>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Static res:Strings.QuickHistoryActionLabel}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding QuickHistoryKey, Converter={StaticResource ShortcutKeyToStringConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"
                                               FontFamily="Consolas"
                                               FontSize="13"/>
                                    <Button Grid.Column="2"
                                            Content="{x:Static res:Strings.EditButtonLabel}"
                                            Padding="12,6"
                                            Click="EditQuickHistoryKey_Click"
                                            MinWidth="60"/>
                                </Grid>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                    <!-- Other Section -->
                    <StackPanel x:Name="OtherSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Collapsed">
                        <Button Content="{x:Static res:Strings.OpenSettingsFolder}"
                                HorizontalAlignment="Center"
                                Padding="24,12"
                                Click="OpenSettingsFolder_Click"
                                Margin="0,0,0,16"/>

                        <!-- クリップボード調査 -->
                        <Button Content="Inspect Clipboard"
                                HorizontalAlignment="Center"
                                Padding="24,12"
                                Click="InspectClipboard_Click"
                                Margin="0,0,0,8"/>
                        <TextBox x:Name="ClipboardInspectBox"
                                 IsReadOnly="True"
                                 FontFamily="HackGen35, HackGen, Consolas"
                                 FontSize="15"
                                 MinHeight="160"
                                 MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AllowDrop="True"
                                 Text = "Press [Inspect Clipboard] or drop anything here to inspect"
                                 PreviewDragOver="ClipboardInspectBox_PreviewDragOver"
                                 PreviewDrop="ClipboardInspectBox_PreviewDrop"
                                 Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Transparent Guard Section -->
                    <StackPanel x:Name="TransparentGuardSection"
                                Margin="42,8"
                                MaxWidth="600"
                                Visibility="Collapsed">
                        <!-- Section Description -->
                        <TextBlock Text="{x:Static res:Strings.TgSectionDescription}"
                                   Opacity="0.75"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap"/>

                        <!-- Enabled -->
                        <CheckBox Content="{x:Static res:Strings.TgIsEnabledLabel}"
                                  ToolTip="{x:Static res:Strings.TgIsEnabledTooltip}"
                                  IsChecked="{Binding TgIsEnabled}"
                                  Margin="0,0,0,24"/>

                        <!-- Size -->
                        <TextBlock Text="{x:Static res:Strings.TgSizeLabel}"
                                   FontWeight="SemiBold"
                                   ToolTip="{x:Static res:Strings.TgSizeTooltip}"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24"
                              ToolTip="{x:Static res:Strings.TgSizeTooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="20"
                                    Maximum="400"
                                    Value="{Binding TgSize}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TgSize, StringFormat={}{0:F0}}"
                                       Width="40"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Activation Pixels -->
                        <TextBlock Text="{x:Static res:Strings.TgActivationPixelsLabel}"
                                   FontWeight="SemiBold"
                                   ToolTip="{x:Static res:Strings.TgActivationPixelsTooltip}"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24"
                              ToolTip="{x:Static res:Strings.TgActivationPixelsTooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="8"
                                    Maximum="20"
                                    Value="{Binding TgActivationPixels}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TgActivationPixels, StringFormat={}{0}}"
                                       Width="40"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Dismiss Delay -->
                        <TextBlock Text="{x:Static res:Strings.TgDismissDelayLabel}"
                                   FontWeight="SemiBold"
                                   ToolTip="{x:Static res:Strings.TgDismissDelayTooltip}"
                                   Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,24"
                              ToolTip="{x:Static res:Strings.TgDismissDelayTooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="10"
                                    Maximum="500"
                                    Value="{Binding TgDismissDelayMs}"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TgDismissDelayMs, StringFormat={}{0}ms}"
                                       Width="50"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>

                    <!-- Pop Window Section -->
                    <StackPanel x:Name="PopWindowSection" Margin="42,8" MaxWidth="600" Visibility="Collapsed">
                        <TextBlock Text="{x:Static res:Strings.PwLinkDropFormatLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedIndex="{Binding PwLinkDropFormat, Converter={StaticResource LinkDropFormatToIndexConverter}, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8">
                            <ComboBoxItem Content="{x:Static res:Strings.PwLinkDropFormatTitleAndUrl}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PwLinkDropFormatMarkdown}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.PwLinkDropFormatUrlOnly}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Quick Text Edit Section -->
                    <StackPanel x:Name="QuickTextSection" Margin="42,8" MaxWidth="600" Visibility="Collapsed">
                        <CheckBox Content="{x:Static res:Strings.QtAutoCopyOnCloseLabel}"
                                  IsChecked="{Binding QtAutoCopyOnClose}"
                                  Margin="0,0,0,16"/>
                        <CheckBox Content="{x:Static res:Strings.QtCloseOnEscLabel}"
                                  IsChecked="{Binding QtCloseOnEsc}"
                                  Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Quick History Section -->
                    <StackPanel x:Name="QuickHistorySection" Margin="42,8" MaxWidth="600" Visibility="Collapsed">
                        <!-- Modifier Key Select -->
                        <CheckBox Content="{x:Static res:Strings.QhModifierSelectLabel}"
                                  IsChecked="{Binding QhModifierSelect}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:Strings.QhModifierSelectDescription}"
                                   FontStyle="Italic"
                                   Opacity="0.75"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <!-- Cancel On Other Key -->
                        <CheckBox Content="{x:Static res:Strings.QhCancelOnOtherKeyLabel}"
                                  IsChecked="{Binding QhCancelOnOtherKey}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:Strings.QhCancelOnOtherKeyDescription}"
                                   FontStyle="Italic"
                                   Opacity="0.75"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <!-- Display Count -->
                        <TextBlock Text="{x:Static res:Strings.QhDisplayCountLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding QhDisplayCount, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="4">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>4</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="5">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>5</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="6">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>6</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="7">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>7</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="8">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>8</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="9">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>9</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="10">
                                <ComboBoxItem.Tag>
                                    <sys:Int32>10</sys:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>

                        <!-- Clipboard History Limit -->
                        <TextBlock Text="{x:Static res:Strings.ClipboardHistoryLimitLabel}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static res:Strings.ClipboardHistoryLimitDescription}"
                                   FontStyle="Italic"
                                   Opacity="0.75"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="ClipboardHistoryLimitCombo"
                                  HorizontalAlignment="Stretch"
                                  Padding="12,8"
                                  SelectionChanged="ClipboardHistoryLimitCombo_SelectionChanged">
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="500"/>
                            <ComboBoxItem Content="1000"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
