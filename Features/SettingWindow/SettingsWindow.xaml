<Window x:Class="Listhing.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Listhing"
        xmlns:views="clr-namespace:Listhing.Views"
        xmlns:viewModels="clr-namespace:Listhing.ViewModels"
        xmlns:controls="clr-namespace:Listhing.Views.Controls"
        xmlns:res="clr-namespace:Listhing"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.MenuPreferences}"
        Height="500"
        Width="740"
        MinWidth="600"
        MinHeight="400"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Closing="Window_Closing">

    <Grid>
        <views:SettingsView DataContext="{Binding SettingsViewModel}"/>
        <!-- モーダルオーバーレイ -->
        <controls:ModalOverlay x:Name="ModalOverlay"
                                Visibility="{Binding DataContext.IsModalVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ModalContent="{Binding CurrentModalContent}"
                                CloseCommand="{Binding DataContext.ModalService.CloseModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Panel.ZIndex="100"/>
    </Grid>
</Window>
