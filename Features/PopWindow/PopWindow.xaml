<Window x:Class="Listhing.Features.PopWindow.PopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="120" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="64" MinHeight="64">
    <Border Background="#CC222222"
            BorderBrush="#88FFFFFF"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー（ドラッグ移動用） -->
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="Transparent"
                  MouseDown="TitleBar_MouseDown">
                <TextBlock Text="Pop" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="11"/>
                <Button x:Name="CloseButton"
                        Content="✕"
                        Width="20" Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        Foreground="#AAFFFFFF"
                        BorderThickness="0"
                        FontSize="10"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- コンテンツ領域（ドラッグ開始・ドロップ受付） -->
            <Border Grid.Row="1"
                    x:Name="ContentArea"
                    Margin="4,0,4,4"
                    Background="#22FFFFFF"
                    CornerRadius="4"
                    AllowDrop="True"
                    Cursor="Hand"
                    MouseLeftButtonDown="ContentArea_MouseLeftButtonDown"
                    DragOver="ContentArea_DragOver"
                    Drop="ContentArea_Drop">
                <Grid>
                    <!-- 中身なし: ドロップ誘導テキスト -->
                    <TextBlock Text="Drop here"
                               Foreground="#55FFFFFF"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasContent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- テキストアイテム表示 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4"
                                  Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="#DDFFFFFF"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- ファイルアイテム表示 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 単一ファイル: シェルアイコン -->
                        <Image Source="{Binding FileIcon}"
                               Width="32" Height="32"
                               HorizontalAlignment="Center"
                               Visibility="{Binding FileIcon, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <!-- 複数ファイル: Stack絵文字 -->
                        <TextBlock Text="{Binding IconText}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#DDFFFFFF"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IconText, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding FileLabel}"
                                   Foreground="#DDFFFFFF"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="100"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
