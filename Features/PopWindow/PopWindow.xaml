<Window x:Class="Listhing.Features.PopWindow.PopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Listhing"
        Width="120" Height="120"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="120" MinHeight="120">
    <Window.Resources>
        <Style x:Key="ContentAreaStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource PopupWindowChromeStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Thumb Width="16" Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Grid.RowSpan="2"
                   Panel.ZIndex="100"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   Padding="0"
                   Margin="0">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- タイトルバー（ドラッグ移動用） -->
            <Grid Grid.Row="0"
                  x:Name="TitleBar"
                  Background="Transparent"
                  MouseDown="TitleBar_MouseDown">
                <Button FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Style="{StaticResource PopupWindowIconButtonStyle}"
                        Foreground="{DynamicResource TextControlForeground}"
                        Content="{Binding PinnedIconText}"
                        Width="24" Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        FontSize="14"
                        Click="CloseOnSuccessButton_Click"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button x:Name="CopyButton"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Style="{StaticResource PopupWindowIconButtonStyle}"
                            Foreground="{DynamicResource TextControlForeground}"
                            Content="&#xE8C8;"
                            Width="24" Height="24"
                            FontSize="14"
                            Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="CopyButton_Click"/>
                    <Button x:Name="CloseButton"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Style="{StaticResource PopupWindowIconButtonStyle}"
                            Foreground="{DynamicResource TextControlForeground}"
                            Content="&#xE106;"
                            Width="24" Height="24"
                            FontSize="14"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- コンテンツ領域（ドラッグ開始・ドロップ受付） -->
            <Border Grid.Row="1"
                    x:Name="ContentArea"
                    Style="{StaticResource ContentAreaStyle}"
                    Margin="5,0,5,5"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource ControlAltFillColorQuarternaryBrush}"
                    AllowDrop="True"
                    Cursor="Hand"
                    MouseLeftButtonDown="ContentArea_MouseLeftButtonDown"
                    MouseMove="ContentArea_MouseMove"
                    MouseLeftButtonUp="ContentArea_MouseLeftButtonUp"
                    DragEnter="ContentArea_DragEnter"
                    DragLeave="ContentArea_DragLeave"
                    DragOver="ContentArea_DragOver"
                    Drop="ContentArea_Drop">
                <Border.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened">
                        <MenuItem x:Name="ShowInExplorerMenuItem"
                                  Header="{x:Static res:Strings.ContextMenuShowInExplorer}"
                                  Click="ShowInExplorer_Click"
                                  Visibility="Collapsed"/>
                        <Separator x:Name="ShowInExplorerSeparator" Visibility="Collapsed"/>
                        <MenuItem x:Name="ClipboardHistoryMenuItem" Header="{x:Static res:Strings.MenuItemClipBoardHistory}"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuItemSetting}" Click="Setting_Click"/>
                        <MenuItem Header="{x:Static res:Strings.MenuItemQuit}" Click="Quit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <!-- 中身なし: ドロップ誘導テキスト -->
                    <TextBlock Text="Drop here"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasContent, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- テキストアイテム表示 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4"
                                  Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding DisplayText}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- ファイルアイテム表示 -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 単一画像ファイル: サムネイル -->
                        <Image Source="{Binding Thumbnail}"
                               MaxWidth="200" MaxHeight="200"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <!-- 単一非画像ファイル: シェルアイコン -->
                        <Image Source="{Binding FileIcon}"
                               Width="32" Height="32"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsImageFile, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <!-- 複数ファイル: Stack絵文字 -->
                        <TextBlock Text="{Binding IconText}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IconText, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding FileLabel}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="4,4,4,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
