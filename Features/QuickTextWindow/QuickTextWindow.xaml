<Window x:Class="Listhing.Features.QuickTextWindow.QuickTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Listhing"
        Width="260" Height="200"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="160" MinHeight="120">
    <Border Style="{StaticResource PopupWindowChromeStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- リサイズグリップ -->
            <Thumb Width="16" Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Grid.RowSpan="2"
                   Panel.ZIndex="100"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta"
                   Padding="0"
                   Margin="0">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- タイトルバー（ドラッグ移動用） -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseDown="TitleBar_MouseDown">
                <TextBlock Text="{x:Static res:Strings.QuickTextWindowTitle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Style="{StaticResource PopupWindowIconButtonStyle}"
                            Foreground="{DynamicResource TextControlForeground}"
                            Content="&#xE8C8;"
                            Width="24" Height="24"
                            FontSize="14"
                            Click="CopyButton_Click"/>
                    <Button FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Style="{StaticResource PopupWindowIconButtonStyle}"
                            Foreground="{DynamicResource TextControlForeground}"
                            Content="&#xE106;"
                            Width="24" Height="24"
                            FontSize="14"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- テキスト編集領域 -->
            <TextBox x:Name="TextEditor"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="5"
                     Margin="5,0,5,5"/>
        </Grid>
    </Border>
</Window>
