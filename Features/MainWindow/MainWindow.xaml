<Window x:Class="Listhing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Listhing"
        xmlns:models="clr-namespace:Listhing.Models"
        xmlns:views="clr-namespace:Listhing.Views"
        xmlns:controls="clr-namespace:Listhing.Views.Controls"
        xmlns:vm="clr-namespace:Listhing.ViewModels"
        xmlns:res="clr-namespace:Listhing"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.ApplicationTitle}"
        Height="450" 
        Width="800"
        MinWidth="600"
        MinHeight="400"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="OnPreviewKeyDown"
        KeyDown="OnKeyDown"
        ContentRendered="OnContentRendered">
    <Window.Resources>
        <Style TargetType="Window" x:Key="MyWindowStyle" BasedOn="{StaticResource DefaultWindowStyle}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
            <WindowChrome CornerRadius="12"
                            CaptionHeight="32"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="True"
                            />
            </Setter.Value>
        </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="MyWindowStyle"/>
    </Window.Style>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar with Menu Button -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button MinWidth="24"
                    MinHeight="24"
                    Margin="8,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="MenuButton_Click"
                    Panel.ZIndex="1" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="12"
                           Text="&#xE70D;"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding AppMenuViewModel.MenuItems}"
                                Opened="AppMenu_Opened" />
                </Button.ContextMenu>
            </Button>
            <TextBlock x:Name="WindowTitleTextBlock"
                       Text="{x:Static res:Strings.ApplicationTitle}"
                       Margin="50,0,0,0"
                       VerticalAlignment="Center"
                       Padding="0,12"
                       Height="36"
                       FontSize="16"
                       Panel.ZIndex="0"/>
        </Grid>
        
         <!-- メインコンテンツ領域 -->
         <Grid Grid.Row="1">
             <!-- メイン画面 -->
             <!-- <views:MainTabContent x:Name="MainContent"/> -->
             
             <!-- モーダルオーバーレイ -->
             <controls:ModalOverlay x:Name="ModalOverlay"
                                         Visibility="{Binding DataContext.IsModalVisible, RelativeSource={RelativeSource AncestorType=Window},  Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ModalContent="{Binding CurrentModalContent}"
                                         CloseCommand="{Binding DataContext.ModalService.CloseModalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Panel.ZIndex="100"/>
         </Grid>
    </Grid>
</Window>
